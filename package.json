{
  "name": "bomb-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts tests/engine/*.test.ts tests/words/*.test.ts tests/server/*.test.ts tests/client/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.e2e.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx scripts/dev-server.ts",
    "load-test": "tsx scripts/load-test.ts",
    "build:words": "tsx scripts/build-words.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@netlify/server": "0.1.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^5"
  }
}
